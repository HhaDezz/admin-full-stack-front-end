# Base URL of the Anjana Admin API (Spring Boot back end)
VITE_API_BASE_URL=http://localhost:8089

# Brand shown in the sidebar, login page and browser tab
VITE_APP_NAME=Anjana

# true = run entirely on built-in sample data, no back end needed. Great for demos.
VITE_DEMO_MODE=false

# false = leave the UI Kit gallery (/ui) out of the build, e.g. for your end users
VITE_SHOWCASE=true

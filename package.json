{
  "name": "atelier-admin",
  "version": "1.0.0",
  "description": "Anjana Admin: React 19 admin app with roles, permissions, an audit log, 87 components, dashboards and app pages.",
  "author": "Anjana Ariyasinghe <anjana7dilan@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "build:standalone": "vite build --config vite.standalone.config.ts && node scripts/rename-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/bundle-budget.mjs",
    "docs:dev": "npm --prefix docs install && npm --prefix docs run dev",
    "docs:build": "npm --prefix docs install && npm --prefix docs run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/fraunces": "5.1.1",
    "@fontsource-variable/inter": "5.1.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.59.16",
    "@tanstack/react-virtual": "3.14.22",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "axios": "1.7.7",
    "date-fns": "4.4.0",
    "lucide-react": "0.454.0",
    "motion": "14.6.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "6.30.1",
    "recharts": "3.10.1",
    "shiki": "4.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.3",
    "axe-core": "4.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9"
  }
}
